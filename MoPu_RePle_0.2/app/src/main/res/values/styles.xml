<resources>

    <style name="CategoryButton" parent="@android:style/Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>

        <!-- 보라색(테마 colorPrimary) tint 완전 차단 -->
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>

        <!-- 우리가 만든 selector 로 배경 지정 -->
        <item name="android:background">@drawable/category_button_selector</item>

        <item name="android:textSize">13sp</item>

        <!-- 선택/비선택 글자색 -->
        <item name="android:textColor">@drawable/category_text_selector</item>
    </style>

</resources>
