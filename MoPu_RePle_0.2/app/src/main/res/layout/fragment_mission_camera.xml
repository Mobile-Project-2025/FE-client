<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.Mission_Camera.Mission_CameraFragment"
    android:paddingTop="41dp">

    <!-- 상단 타이틀 -->
    <TextView
        android:id="@+id/Title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Re:Ple"
        android:textColor="@color/eco_green_bright"
        android:textStyle="bold"
        android:textSize="30sp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/Title_underline"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#AFAFAF"
        app:layout_constraintTop_toBottomOf="@id/Title_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- 챌린지 정보 박스 전체 linear -->
    <LinearLayout
        android:id="@+id/mission_camera_linear_challenge_info"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/border_box_gray"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/Title_underline"
        android:layout_marginTop="16dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <!-- "챌린지 정보" text -->
        <TextView
            android:id="@+id/mission_camera_Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="챌린지 정보"
            android:textSize="17sp"
            android:textStyle="bold"
            android:paddingBottom="10dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="10dp"/>


        <!-- linear == 미션 아이콘 + 이름 + 기간 -->
        <LinearLayout
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/mission_camera_Image"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_mission"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mission_camera_Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="텀블러 사용하기"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/mission_camera_Duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기간   02.14 (월) ~ 02.25 (금)"
                    android:textSize="14sp"
                    android:paddingTop="3dp"
                    android:textColor="#777777"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="10dp"/>


        <!-- 참여인원, 포인트 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/default_profile"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/mission_camera_how_much_people"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="참가인원     7명"
                android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_coin"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/mission_camera_how_much_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="point     300p"
                android:textSize="15sp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="10dp"/>


        <!-- 미션 설명 == title, content 2개로 구분 -->
        <TextView
            android:id="@+id/mission_camera_Info_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미션 설명"
            android:textSize="17sp"
            android:textStyle="bold"
            android:paddingBottom="10dp"/>
        <TextView
            android:id="@+id/mission_camera_Info_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="어쩌고 저쩌고 어쩌고 저쩌고 궳둟쉟렑"
            android:textSize="14sp"
            android:textColor="#666666"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>


    <!-- 이미지 & 촬영 버튼 -->
<!--    <ImageView-->
<!--        android:id="@+id/mission_camera_Image_Box"-->
<!--        android:layout_width="96dp"-->
<!--        android:layout_height="96dp"-->
<!--        android:background="@color/gray"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@+id/mission_camera_linear_challenge_info"-->
<!--        android:layout_marginTop="24dp" />-->

    <Button
        android:id="@+id/mission_camera_Button_Participate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/eco_green_bright"
        android:text="참여하기"
        android:textSize="20sp"

        android:padding="6dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/mission_camera_Preview_before_Submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.9" />


    <!-- 사진 촬영한 후에, 제출 전 미리보기 -->
    <ImageView
        android:id="@+id/mission_camera_Preview_before_Submit"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:background="#DDDDDD"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/mission_camera_linear_challenge_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>