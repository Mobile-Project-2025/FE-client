<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- 상단 로고 -->
        <ImageView
            android:id="@+id/admin_logo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_reple"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/admin_logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Re:ple"
            android:textColor="#2E7D32"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            app:layout_constraintTop_toBottomOf="@id/admin_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/admin_logo_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recycle People"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/admin_logo_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 미션 제목 -->
        <TextView
            android:id="@+id/label_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미션 제목"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/admin_logo_sub"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_title"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/edit_background"
            android:padding="12dp"
            android:hint="미션제목"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_title" />

        <!-- 카테고리 -->
        <TextView
            android:id="@+id/label_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미션 카테고리"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/et_title"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/layout_category_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/label_category"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
0
            <Button
                android:id="@+id/btn_category_dump"
                style="@style/CategoryButton"
                android:text="텀블러" />

            <Button
                android:id="@+id/btn_category_etc"
                style="@style/CategoryButton"
                android:text="기타" />

            <Button
                android:id="@+id/btn_category_transport"
                style="@style/CategoryButton"
                android:text="대중교통" />

            <Button
                android:id="@+id/btn_category_recycle"
                style="@style/CategoryButton"
                android:text="재활용" />

        </LinearLayout>

        <!-- 미션 종류 -->
        <TextView
            android:id="@+id/label_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미션 종류"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/layout_category_group"
            app:layout_constraintStart_toStartOf="parent" />

        <RadioGroup
            android:id="@+id/rg_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/label_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/rb_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상시 미션" />

            <RadioButton
                android:id="@+id/rb_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="돌발 미션"
                android:layout_marginLeft="20dp" />
        </RadioGroup>

        <!-- 기간 -->
        <TextView
            android:id="@+id/label_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미션 기간"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/rg_type"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/layout_period"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_period">

            <EditText
                android:id="@+id/et_start_date"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/edit_background"
                android:hint="시작일 yyyy-MM-dd"
                android:padding="12dp" />

            <EditText
                android:id="@+id/et_end_date"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/edit_background"
                android:layout_marginStart="8dp"
                android:hint="종료일 yyyy-MM-dd"
                android:padding="12dp" />
        </LinearLayout>

        <!-- 포인트 -->
        <TextView
            android:id="@+id/label_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미션 포인트"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/layout_period"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_point"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/edit_background"
            android:padding="12dp"
            android:inputType="number"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/label_point"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 설명 -->
        <TextView
            android:id="@+id/label_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미션 설명"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/et_point"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_content"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:background="@drawable/edit_background"
            android:padding="12dp"
            android:gravity="top"
            android:layout_marginTop="8dp"
            android:inputType="textMultiLine"
            app:layout_constraintTop_toBottomOf="@id/label_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 하단 버튼 -->
        <LinearLayout
            android:id="@+id/layout_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btn_preview"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="미리보기"
                android:textColor="#000000"
                android:backgroundTint="#FFFFFF" />

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="미션 등록하기"
                android:enabled="false"
                android:textColor="#888888"
                android:backgroundTint="#E0E0E0" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
