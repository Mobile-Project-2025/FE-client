<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_round_white">

    <!-- 제목 -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정말로 승인/반려하시겠습니까?"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <!-- 설명 -->
    <TextView
        android:id="@+id/tvDialogSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="확인 후에는 수정할 수 없습니다. 제출물을 꼭 다시 한번 확인해주세요."
        android:textSize="12sp"
        android:textColor="#888888" />

    <!-- 버튼 두 개 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_outline_gray"
            android:text="반려하기"
            android:textSize="14sp"
            android:textColor="#555555" />

        <Space
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/btnApprove"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_solid_black"
            android:text="승인하기"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />


    </LinearLayout>

</LinearLayout>
