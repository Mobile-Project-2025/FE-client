<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 관리자 글자 오른쪽 상단 -->
    <TextView
        android:id="@+id/admin_mission_list_text_gwanliza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="40dp"
        android:text="관리자"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 필터 버튼들 (위에 고정) -->
    <LinearLayout
        android:id="@+id/admin_mission_list_linear_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/admin_mission_list_text_gwanliza"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/admin_mission_button_type_mission_all"
            style="@style/AdminFilterButton"
            android:text="전체 미션" />

        <Button
            android:id="@+id/admin_mission_button_type_mission_1"
            style="@style/AdminFilterButton"
            android:text="승인 대기 미션" />

        <Button
            android:id="@+id/admin_mission_button_type_mission_2"
            style="@style/AdminFilterButton"
            android:text="마감된 미션" />

        <Button
            android:id="@+id/admin_mission_button_type_mission_3"
            style="@style/AdminFilterButton"
            android:text="종료 미션" />
    </LinearLayout>

    <!-- 미션 카드들: 스크롤 가능 영역 -->
    <ScrollView
        android:id="@+id/admin_mission_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/admin_mission_list_linear_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ScrollView는 자식 1개만 가능 → 이 안에 미션 카드들 쌓임 -->
        <LinearLayout
            android:id="@+id/admin_mission_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
