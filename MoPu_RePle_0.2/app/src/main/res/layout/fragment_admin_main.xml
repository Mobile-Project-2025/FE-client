<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<!-- 관리자 글자 오른쪽 상단 -->
    <TextView
        android:id="@+id/admin_main_text_gwanliza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="40dp"

        android:text="관리자" />

<!-- 상단 앱 아이콘, 이름 Re:Ple -->
    <ImageView
        android:id="@+id/login_icon"
        android:src="@drawable/ic_reple"
        android:layout_width="67dp"
        android:layout_height="67dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="450dp" />

    <TextView
        android:id="@+id/login_RePle_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/eco_green_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_icon"
        android:layout_marginStart="0dp"

        android:text="Re:Ple" />

    <TextView
        android:id="@+id/login_RePle_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/eco_green_bright"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_RePle_1"
        android:layout_marginStart="0dp"

        android:text="Recycle People" />



<!-- 버튼 2개 == 미션 설정 / 미션 목록 확인 -->
    <Button
        android:id="@+id/admin_main_button1_mission_setting"
        android:layout_width="135dp"
        android:layout_height="45dp"
        android:textSize="14sp"
        android:backgroundTint="@color/eco_green_bright"
        android:textColor="@color/white"
        android:singleLine="true"
        android:ellipsize="none"
        android:scrollHorizontally="true"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="75dp"

        android:text="미션 설정" />

    <Button
        android:id="@+id/admin_main_button2_mission_list_check"
        android:layout_width="135dp"
        android:layout_height="45dp"
        android:textSize="14sp"
        android:backgroundTint="@color/eco_green_bright"
        android:textColor="@color/white"
        android:singleLine="true"
        android:ellipsize="none"
        android:scrollHorizontally="true"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="75dp"

        android:text="미션 목록 확인" />



</androidx.constraintlayout.widget.ConstraintLayout>