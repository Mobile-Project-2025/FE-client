<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 상단 앱 아이콘, 이름 Re:Ple -->
    <ImageView
        android:id="@+id/login_icon"
        android:src="@drawable/ic_reple"
        android:layout_width="67dp"
        android:layout_height="67dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="450dp" />

    <TextView
        android:id="@+id/login_RePle_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/eco_green_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_icon"
        android:layout_marginStart="0dp"

        android:text="Re:Ple" />

    <TextView
        android:id="@+id/login_RePle_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/eco_green_bright"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_RePle_1"
        android:layout_marginStart="0dp"

        android:text="Recycle People" />


    <EditText
        android:id="@+id/login_ID"
        android:layout_width="360dp"
        android:layout_height="48dp"
        android:inputType="number"
        android:background="@drawable/border_box_lightgreen"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/login_RePle_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"

        android:hint="학번" />

    <EditText
        android:id="@+id/login_PW"
        android:layout_width="360dp"
        android:layout_height="48dp"
        android:inputType="textPassword"
        android:background="@drawable/border_box_lightgreen"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/login_ID"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"

        android:hint="비밀번호" />

    <Button
        android:id="@+id/login_button"
        android:layout_width="363dp"
        android:layout_height="49dp"
        android:textSize="16sp"
        android:backgroundTint="@color/eco_green_bright"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/login_PW"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"

        android:text="로그인" />

    <Button
        android:id="@+id/login_movetoSignup"
        android:background="@android:color/transparent"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/login_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:text="회원가입 하기" />

    <Button
        android:id="@+id/login_movetoTempAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:backgroundTint="@color/eco_green_bright"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/login_movetoSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"

        android:text="(임시) 관리자 화면 이동" />

</androidx.constraintlayout.widget.ConstraintLayout>