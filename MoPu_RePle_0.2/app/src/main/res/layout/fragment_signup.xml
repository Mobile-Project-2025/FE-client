<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/signup_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="35sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="25dp"
        android:layout_marginTop="75dp"

        android:text="회원가입" />


<!--  닉네임 입력 -->
    <TextView
        android:id="@+id/signup_plsNickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/signup_top"
        android:layout_marginStart="25dp"
        android:layout_marginTop="75dp"

        android:text="닉네임 입력" />

    <EditText
        android:id="@+id/signup_inputNickname"
        android:layout_width="271dp"
        android:layout_height="49dp"
        android:inputType="text"
        android:background="@drawable/border_box_lightgreen"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/signup_plsNickname"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"

        android:hint="닉네임을 입력해주세요" />

    <Button
        android:id="@+id/signup_checkNickname"
        android:layout_width="82dp"
        android:layout_height="58dp"
        android:textSize="14sp"
        android:backgroundTint="@color/eco_green_bright"
        android:textColor="@color/white"
        android:singleLine="true"
        android:ellipsize="none"
        android:scrollHorizontally="true"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/signup_inputNickname"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/signup_inputNickname"
        android:layout_marginTop="-5dp"

        android:text="중복확인" />

    <TextView
        android:id="@+id/signup_plsChangeNickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_inputNickname"
        android:layout_marginStart="25dp"
        android:layout_marginTop="2.5dp"

        android:text="닉네임 중복입니다!" />

    <TextView
        android:id="@+id/signup_itsOkNickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_inputNickname"
        android:layout_marginStart="25dp"
        android:layout_marginTop="2.5dp"

        android:text="사용 가능한 닉네임입니다" />



    <!-- 학번 입력 -->
    <TextView
        android:id="@+id/signup_plsStudentID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_inputNickname"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"

        android:text="학번 입력" />

    <EditText
        android:id="@+id/signup_inputStudentID"
        android:layout_width="271dp"
        android:layout_height="49dp"
        android:inputType="number"
        android:background="@drawable/border_box_lightgreen"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/signup_plsStudentID"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"

        android:hint="학번을 입력해주세요" />

    <Button
        android:id="@+id/signup_checkStudentID"
        android:layout_width="82dp"
        android:layout_height="58dp"
        android:textSize="14sp"
        android:backgroundTint="@color/eco_green_bright"
        android:textColor="@color/white"
        android:singleLine="true"
        android:ellipsize="none"
        android:scrollHorizontally="true"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/signup_inputStudentID"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/signup_inputStudentID"
        android:layout_marginTop="-5dp"

        android:text="중복확인" />

    <TextView
        android:id="@+id/signup_plsChangeStudentID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_inputStudentID"
        android:layout_marginStart="25dp"
        android:layout_marginTop="2.5dp"

        android:text="학번 중복입니다!" />

    <TextView
        android:id="@+id/signup_itsOkStudentID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_inputStudentID"
        android:layout_marginStart="25dp"
        android:layout_marginTop="2.5dp"

        android:text="사용 가능한 학번입니다" />





    <!-- 비밀번호 1차 입력 -->
    <TextView
        android:id="@+id/signup_plsPassword_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_inputStudentID"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"

        android:text="비밀번호 입력" />

    <EditText
        android:id="@+id/signup_inputPassword_1"
        android:layout_width="363dp"
        android:layout_height="49dp"
        android:inputType="textPassword"
        android:background="@drawable/border_box_lightgreen"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/signup_plsPassword_1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"

        android:hint="비밀번호를 입력해주세요" />




<!-- 비밀번호 2차 확인 입력 -->
    <TextView
        android:id="@+id/signup_plsPassword_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_inputPassword_1"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"

        android:text="비밀번호 확인" />

    <EditText
        android:id="@+id/signup_inputPassword_2"
        android:layout_width="363dp"
        android:layout_height="49dp"
        android:inputType="textPassword"
        android:background="@drawable/border_box_lightgreen"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/signup_plsPassword_2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"

        android:hint="비밀번호를 한번 더 입력해주세요" />



<!-- 회원가입 버튼 -->
    <Button
        android:id="@+id/signup_button"
        android:layout_width="363dp"
        android:layout_height="49dp"
        android:backgroundTint="@color/eco_green_bright"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/signup_inputPassword_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp"

        android:text="회원가입 하기" />

</androidx.constraintlayout.widget.ConstraintLayout>