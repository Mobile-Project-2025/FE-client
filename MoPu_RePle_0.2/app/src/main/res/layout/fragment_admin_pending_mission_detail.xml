<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 스크롤되는 본문 -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_approve"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layout_detail_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 헤더 영역: 아이콘 + 제목 + 날짜/포인트 -->
            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_mission_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/border_box_lightgreen"
                    android:padding="8dp"
                    android:src="@drawable/default_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tv_mission_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="텀블러 사용하기"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_mission_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2025-02-14 생성 · 300P"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>

            <!-- 미션 설명 박스 -->
            <LinearLayout
                android:id="@+id/layout_desc_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_desc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="미션 설명"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mission_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="이곳에 서버에서 내려주는 미션 설명을 표시합니다."
                    android:textSize="13sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <!-- 참가작 제목 -->
            <TextView
                android:id="@+id/tv_participation_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="참여자 목록"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 참가작 리스트 컨테이너 -->
            <LinearLayout
                android:id="@+id/layout_participation_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <!-- 참가작 없을 때 안내 문구 -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="승인 대기 중인 참가작이 없습니다."
                android:textSize="13sp"
                android:textColor="#888888"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- 하단 승인 버튼 -->
    <Button
        android:id="@+id/btn_approve"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:text="승인하기"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/eco_green_bright"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
